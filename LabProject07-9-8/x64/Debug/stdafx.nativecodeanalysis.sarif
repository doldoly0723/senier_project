                          },
                          "region": {
                            "startLine": 109,
                            "startColumn": 27
                          }
                        },
                        "message": {
                          "text": "'pd3dBuffer'은(는) NULL(이)면 안 됩니다. 이는 'UpdateSubresources'의 SAL 주석과 일치하지 않습니다."
                        }
                      },
                      "kinds": [
                        "usage"
                      ],
                      "importance": "essential"
                    }
                  ]
                }
              ]
            }
