                        "message": {
                          "text": "'pd3dBuffer'은(는) 'UpdateSubresources'(c:\\users\\akdl6\\onedrive\\문서\\github\\senier_project\\senier_project\\labproject07-9-8\\d3dx12.h:1877에서 선언됨)에 대한 입력입니다."
                        }
                      },
                      "kinds": [
                        "usage"
                      ],
                      "importance": "important"
                    },
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": {
